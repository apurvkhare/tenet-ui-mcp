# Copy to .env (gitignored) and fill in. Only needed to deploy or to run --remote commands;
# `npm run worker:dev` works without it.

# From: npx wrangler kv namespace create OAUTH_KV
OAUTH_KV_ID=

# From: npx wrangler kv namespace create DESIGNS
DESIGNS_KV_ID=

# Your workers.dev subdomain: the <sub> in https://tenet-ui-mcp.<sub>.workers.dev
WORKERS_SUBDOMAIN=
