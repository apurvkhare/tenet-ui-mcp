{
  "name": "tenet-ui-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Design-to-code MCP server for the tenet-ui design system: ingest pipeline, catalog tools, plan / audit / checks.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ingest": "tsx src/ingest/cli.ts",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "stdio": "tsx src/stdio.ts",
    "token": "tsx src/auth/cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "worker:bundle": "node scripts/bundle-snapshots.mjs",
    "worker:dev": "npm run worker:bundle && node scripts/with-env.mjs wrangler dev --port 8789",
    "deploy": "npm run worker:bundle && node scripts/with-env.mjs wrangler deploy",
    "logs": "node scripts/logs.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@cloudflare/workers-oauth-provider": "^0.10.4",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/pngjs": "^6.0.5",
    "jose": "^6.2.12",
    "pngjs": "^7.0.0",
    "tar": "^7.4.3",
    "typescript": "^5.9.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "wrangler": "^4.152.0"
  }
}
